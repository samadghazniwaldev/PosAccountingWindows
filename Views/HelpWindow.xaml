<Window x:Class="PosAccountingApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PosAccountingApp.Resources"
        Title="{loc:Localize 'راهنمای استفاده از برنامه'}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        FlowDirection="{DynamicResource InterfaceDirection}"
        Language="{DynamicResource InterfaceLanguage}"
        Background="#FFF0F4F8"
        Icon="{StaticResource AppIcon}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*"/>
            <ColumnDefinition Width="0.50*"/>
            <ColumnDefinition Width="0.25*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1" Background="White" CornerRadius="12"
                BorderBrush="#FFE0E0E0" BorderThickness="1"
                Margin="20" Padding="32,24">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FF0078D4" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"/>
                            <TextBlock Text="{loc:Localize 'راهنمای استفاده از برنامه'}" FontSize="18" FontWeight="Bold"
                                       Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="{loc:Localize 'بستن'}" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left" Padding="14,6" FontSize="12"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Section 1 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱. راه‌اندازی اولیه'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Setup'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 2 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۲. ورود به سیستم'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Login'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 3 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۳. داشبورد'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Dashboard'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 4 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۴. صندوق فروشگاهی'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Checkout'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 5 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۵. مدیریت کالاها'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Products'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 6 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۶. دسته‌بندی کالاها'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Categories'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 7 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۷. مدیریت مشتریان'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Customers'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 8 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۸. خزانه‌داری و چک'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Cheques'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 9 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۹. هزینه‌ها'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Expenses'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 10 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱۰. جستجوی سراسری'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Search'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 11 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱۱. خروجی و چاپ'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Export'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 12 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱۲. تنظیمات'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Settings'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 13 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱۳. میانبرهای صفحه‌کلید'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Shortcuts'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 14 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱۴. مدیریت کاربران'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Users'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 15 -->
                        <Border Background="#FFF5F7FA" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="{loc:Localize '۱۵. پشتیبان‌گیری'}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0078D4" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Text="{loc:Localize 'Help.Backup'}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
