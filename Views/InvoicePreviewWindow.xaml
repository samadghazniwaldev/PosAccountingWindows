<Window x:Class="PosAccountingApp.Views.InvoicePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PosAccountingApp.Resources"
        Title="{loc:Localize 'پیش‌نمایش فاکتور'}"
        Width="550" Height="750"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{DynamicResource InterfaceDirection}"
        Language="{DynamicResource InterfaceLanguage}"
        Background="White"
        Icon="{StaticResource AppIcon}">

    <DockPanel Margin="24">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF107C10" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="{loc:Localize 'فاکتور فروش'}" FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" FontSize="16" HorizontalAlignment="Left"
                        Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- Invoice Content -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="550">
            <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Shop Name -->
                    <TextBlock x:Name="ShopNameLabel" FontSize="22" FontWeight="Bold"
                               Foreground="#FF0078D4" HorizontalAlignment="Center"
                               Text="{loc:Localize 'فروشگاه'}"/>
                    <TextBlock x:Name="InvoiceNumLabel" FontSize="12"
                               Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Text="{loc:Localize 'شماره فاکتور:'}"/>
                    <TextBlock x:Name="DateLabel" FontSize="12"
                               Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,2,0,12"
                               Text="{loc:Localize 'تاریخ:'}"/>

                    <Separator Background="#FFE0E0E0" Margin="0,0,0,10"/>

                    <!-- Items -->
                    <TextBlock Text="{loc:Localize 'آیتم‌ها:'}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Localize 'کالا'}" Binding="{Binding ProductTitle}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Localize 'تعداد'}" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="{loc:Localize 'قیمت'}" Binding="{Binding UnitPrice}" Width="80"/>
                            <DataGridTextColumn Header="{loc:Localize 'جمع'}" Binding="{Binding Subtotal}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Separator Background="#FFE0E0E0" Margin="0,10,0,10"/>

                    <!-- Totals -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{loc:Localize 'جمع کل:'}" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="SubtotalLabel" Text="0" HorizontalAlignment="Right" FontSize="13"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{loc:Localize 'مالیات:'}" HorizontalAlignment="Left" Foreground="#FF888888" FontSize="12"/>
                        <TextBlock x:Name="TaxLabel" Text="0" HorizontalAlignment="Right" FontSize="12" Foreground="#FF888888"/>
                    </Grid>
                    <Separator Background="#FFE0E0E0" Margin="0,6,0,6"/>
                    <Grid>
                        <TextBlock Text="{loc:Localize 'مبلغ قابل پرداخت:'}" HorizontalAlignment="Left" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="TotalLabel" Text="0" HorizontalAlignment="Right"
                                   FontSize="18" FontWeight="Bold" Foreground="#FF107C10"/>
                    </Grid>
                    <Separator Background="#FFE0E0E0" Margin="0,10,0,8"/>
                    <TextBlock x:Name="StatusLabel" Text="{loc:Localize 'وضعیت: پرداخت شده'}" FontSize="12"
                               Foreground="#FF107C10" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FooterLabel" Text="{loc:Localize 'با تشکر از خرید شما'}" FontSize="11"
                               Foreground="#FFAAAAAA" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{loc:Localize 'ستاره‌دار کردن'}" Style="{StaticResource WarningButton}" Margin="0,0,8,0"
                    Click="Star_Click" x:Name="StarBtn"/>
            <Button Content="{loc:Localize 'چاپ'}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Click="Print_Click"/>
            <Button Content="{loc:Localize 'بستن'}" Style="{StaticResource OutlineButton}"
                    Click="Close_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
